# Copy to .env.local. Nothing here is secret: VITE_* values end up in the bundle.

# Base path of the BFF, same origin as the SPA (the CDN or ingress routes it to the BFF).
VITE_API_BASE_URL=/api

# Where the BFF starts the login flow. On a 401 the app redirects here with ?returnTo=<path>.
VITE_LOGIN_URL=/api/auth/login

# "true" starts the MSW mock BFF in the browser (`pnpm dev:mock` sets it via .env.mock).
VITE_API_MOCKS=false

# Dev server only (not bundled): real BFF to proxy VITE_API_BASE_URL to.
# API_PROXY_TARGET=https://bff.dev.example.com
