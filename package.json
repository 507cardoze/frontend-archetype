{
  "name": "frontend-archetype",
  "description": "Pragma Chapter Frontend archetype: internal React SPA that consumes a BFF, atomic design, Figma-driven theme.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b && biome check --write src scripts e2e",
    "lint:ci": "tsc -b && biome ci src scripts e2e",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "tokens": "node scripts/build-tokens.ts",
    "quality": "node scripts/quality-gate.ts",
    "analyze": "fallow",
    "deploy:s3": "node scripts/deploy.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.0",
    "@biomejs/biome": "2.6.6",
    "@playwright/test": "1.65.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "fallow": "3.42.0",
    "jsdom": "31.0.0",
    "msw": "2.15.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "src/mocks/public"
    ]
  }
}
